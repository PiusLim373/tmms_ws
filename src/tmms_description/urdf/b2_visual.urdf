<?xml version="1.0"?>
<robot name="b2_visual">
  <!-- Display-only B2 model for Lichtblick and the mapping/ robot_state_publisher. Derived from
     tmms_description.urdf.xacro: the links that have visuals and the leg joints between them.
     Mesh paths are relative to this file, so Lichtblick fetches them from wherever it loaded
     it; package:// would need the rosbridge player to fetch assets, which it cannot.
     Regenerate if the legs or meshes change. -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/base_link.dae" />
      </geometry>
    </visual>
  </link>
  <link name="FL_hip">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/FL_hip.dae" />
      </geometry>
    </visual>
  </link>
  <link name="FL_thigh">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/FL_thigh.dae" />
      </geometry>
    </visual>
  </link>
  <link name="FL_calf">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/FL_calf.dae" />
      </geometry>
    </visual>
  </link>
  <link name="FR_hip">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/FR_hip.dae" />
